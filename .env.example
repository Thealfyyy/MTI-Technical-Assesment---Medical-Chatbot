# MTI Medical Knowledge Chatbot — Non-Secret Configuration Example
# Copy to .env for local overrides. Never commit real secrets or API keys.

# ---------------------------------------------------------------------------
# Project & External Storage Root
# ---------------------------------------------------------------------------
# On the development laptop and RTX 3090 benchmark PC, all persistence,
# caches, source copies, indices, SQLite databases, and evaluation outputs
# live under the shared external HDD root.
# Optional override. Leave unset to use the project checkout directory on this machine.
# PROJECT_ROOT=E:/Projects/MTI Technical Assesment - Medical Chatbot
REQUIRE_WRITABLE_STORAGE=true

# Corpus & Persistence Paths (relative to PROJECT_ROOT or absolute)
CORPUS_DIR=Docs/Data
KB_MANIFEST_PATH=data/kb_manifest.yaml
CHROMA_PERSIST_DIR=data/chroma
SQLITE_DB_PATH=data/sqlite/app.db
UPLOADS_DIR=data/uploads
EVAL_RESULTS_DIR=evaluation/results

# Model & Package Cache Directories (kept on external drive off C:)
MODEL_CACHE_DIR=.cache/models
HF_HOME=.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=.cache/sentence_transformers
PIP_CACHE_DIR=.cache/pip
TMPDIR=.cache/tmp

# ---------------------------------------------------------------------------
# API Server Settings
# ---------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=28.0

# ---------------------------------------------------------------------------
# Open-Weights LLM Runtime Settings (llama.cpp OpenAI-compatible server)
# ---------------------------------------------------------------------------
# Note: Final model selection is gated on Phase 1 dual-machine benchmarks.
LLM_SERVER_URL=http://localhost:8080
LLM_MODEL_NAME=Qwen3-8B-Q4_K_M
LLM_GGUF_REPO=Qwen/Qwen3-8B-GGUF
LLM_GGUF_FILE=Qwen3-8B-Q4_K_M.gguf
LLM_GGUF_REVISION=7c41481f57cb95916b40956ab2f0b139b296d974
LLM_CONTEXT_SIZE=4096
# 768: list-heavy Arabic answers plus evidence quotes overran 512 and returned
# invalid (truncated) JSON on the RTX 3090 acceptance run.
LLM_MAX_TOKENS=768
LLM_TEMPERATURE=0.0
LLM_GPU_LAYERS=0

# ---------------------------------------------------------------------------
# Administrative Console Authentication
# ---------------------------------------------------------------------------
# Enforces HTTP Basic Authentication on /admin, /admin/documents, /admin/analytics, and /admin/handoffs.
ADMIN_AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# ---------------------------------------------------------------------------
# Candidates under Phase 1 comparison:
#   - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (rev: e8f8c211226b894fcb81acc59f3b34ba3efd5f42)
#   - BAAI/bge-m3 (rev: 5617a9f61b028005a4858fdac845db406aefb181)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DEVICE=cpu
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.50
